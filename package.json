{
  "name": "overly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Stream widgets, overlays and automations that run on your own machine.",
  "license": "MIT",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "bun run --filter @overly/server --filter @overly/dashboard dev",
    "dev:desktop": "bun run build && cargo run --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "build": "bun run --filter @overly/dashboard build && bun run --filter @overly/server build",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:desktop": "cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test:sidecar": "OVERLY_SIDECAR_ENTRY=apps/server/dist/sidecar/server.mjs vitest run --project @overly/server main.process"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
