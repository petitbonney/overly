{
  "name": "@overly/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Overly Node sidecar: HTTP/WS server, platforms, pipeline engine, plugin host, storage.",
  "license": "MIT",
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts --port 6860 --data-dir ../../.dev-data --dev-origin http://localhost:5173 --plugins-dir ../../plugins --overlay-sdk ../../packages/sdk/dist/browser/overlay.js --pretty-logs",
    "build": "bun build src/main.ts --target=node --format=esm --outfile=dist/sidecar/server.mjs --external bufferutil --external utf-8-validate --external pino-pretty && bun scripts/copy-runtime-files.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "@overly/plugin-text-banner": "workspace:*",
    "@overly/sdk": "workspace:*",
    "@overly/shared": "workspace:*",
    "fastify": "5.12.7",
    "pino": "10.4.0",
    "pino-roll": "4.0.0",
    "semver": "7.8.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/semver": "7.8.0",
    "@types/ws": "8.18.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "ws": "8.22.0"
  }
}
